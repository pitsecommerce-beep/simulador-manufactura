# ============================================================================
# Variables de entorno. En producción se definen SOLO en Railway (por servicio).
# Para desarrollo local, copia este archivo a .env y rellena los valores.
# Nunca subas .env al repositorio.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (Dashboard > Project Settings > API Keys / Connect)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<ref>.supabase.co
# Clave publicable (sb_publishable_...) o la clave "anon" heredada. Es pública por diseño.
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...) o la "service_role" heredada. SOLO api y workers.
SUPABASE_SECRET_KEY=
# Solo si el proyecto sigue usando el secreto JWT heredado (HS256). Con llaves
# asimétricas (proyectos nuevos) déjala vacía: la API usa JWKS.
SUPABASE_JWT_SECRET=
# Conexión Postgres para la cola de trabajos (solo workers) y, opcionalmente, para
# `pnpm db:migrate` en local. El api NO la necesita: las migraciones se aplican a mano
# en Supabase > SQL Editor con supabase/manual/apply_all.sql (ver README).
# Usa la cadena "Session pooler" (compatible con IPv4 y con LISTEN/NOTIFY).
# No uses el "Transaction pooler" (puerto 6543): no soporta LISTEN.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Servicio api
# ---------------------------------------------------------------------------
# Railway define PORT automáticamente.
PORT=8080
LOG_LEVEL=info
# Orígenes permitidos (URL pública del servicio web), separados por comas.
# Se ignoran espacios y la diagonal final.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=300

# ---------------------------------------------------------------------------
# Servicio web (en Railway, sin prefijo VITE_; se inyectan en /config.js al arrancar)
# ---------------------------------------------------------------------------
API_URL=https://<api>.up.railway.app
# SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY: mismos valores de arriba.

# Desarrollo local con `pnpm dev:web` (Vite lee estas):
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Motor de línea (sim-worker) visto desde el api. Sin SIM_WORKER_URL, simular está desactivado.
# En Railway: http://sim-worker.railway.internal:8080 (red privada, sin dominio público).
SIM_WORKER_URL=http://localhost:8080
# Token compartido entre api y sim-worker (mínimo 16 caracteres; openssl rand -hex 32).
SIM_WORKER_TOKEN=
SIM_MAX_REPLICATIONS=50
SIM_MAX_HORIZON_H=720
SIM_RUN_TIMEOUT_S=1800

# ---------------------------------------------------------------------------
# sim-worker (servicio HTTP interno). No usa DATABASE_URL.
# ---------------------------------------------------------------------------
# SUPABASE_URL, SUPABASE_SECRET_KEY y SIM_WORKER_TOKEN: los mismos de arriba.
# PORT=8080
# SIM_MAX_CONCURRENT_RUNS=1

# ---------------------------------------------------------------------------
# cad-worker (fase 2b): cola de trabajos en Postgres
# ---------------------------------------------------------------------------
# DATABASE_URL: la misma de arriba.
POLL_SECONDS=5

# ---------------------------------------------------------------------------
# Tests locales (Postgres de docker-compose; no es Supabase)
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Fases futuras (aún sin uso). Se documentan para planificar Railway.
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic            # anthropic | openai
# AI_MODEL=                        # nombre del modelo; nunca fijado en el código
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_DAILY_TOKEN_LIMIT=
# AI_DAILY_REQUEST_LIMIT=
# SIGNED_URL_TTL_SECONDS=300
# SIM_MAX_REPLICATIONS=200
# CAD_TESSELLATION_TOLERANCE=0.5
# CAD_MAX_TRIANGLES_PER_LINK=50000
